{
  "name": "effect-cursor-sdk",
  "version": "0.4.1",
  "description": "Effect-based wrapper around the Cursor SDK",
  "keywords": [
    "cursor",
    "effect",
    "sdk"
  ],
  "homepage": "https://github.com/benjamin-kraatz/effect-cursor-sdk#readme",
  "bugs": {
    "url": "https://github.com/benjamin-kraatz/effect-cursor-sdk/issues"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benjamin-kraatz/effect-cursor-sdk.git"
  },
  "files": [
    "dist",
    "README.md",
    "DEPRECATIONS.md",
    "LICENSE",
    "docs"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "changeset:agent": "node --import tsx ./scripts/create-changeset-agent.ts",
    "changeset": "changeset",
    "prepare": "effect-language-service patch",
    "prepack": "bun run build",
    "prepublishOnly": "bun run verify:publish",
    "release": "bun run verify:publish && changeset publish",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "examples:typecheck": "bun run --cwd examples/quickstart typecheck && bun run --cwd examples/cli typecheck && bun run --cwd examples/basic-agent-workflow typecheck && bun run --cwd examples/advanced-ops-dashboard typecheck",
    "examples:cli:mock": "bun run --cwd examples/cli dev -- --mock \"Summarize the mock response\"",
    "examples:advanced:mock": "bun run --cwd examples/advanced-ops-dashboard dev -- --mock --triage",
    "sdk-audit": "bun scripts/sdk-surface-audit.ts",
    "sdk-audit:refresh": "bun scripts/sdk-surface-audit.ts --write-baseline",
    "lint:package": "publint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "version": "changeset version",
    "verify:publish": "bun run typecheck && bun run sdk-audit && bun run lint && bun run test && bun run build && bun run lint:package"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.26",
    "effect-cursor-sdk": "."
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@effect/language-service": "^0.87.1",
    "@effect/platform-node": "^4.0.0-beta.103",
    "@effect/vitest": "4.0.0-beta.103",
    "@types/bun": "latest",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.1.10",
    "effect": "^4.0.0-beta.103",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "effect": "^4.0.0-beta.103",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
